{
  "name": "@itsaorg/storage-base",
  "description": "Zero-dependency TypeScript contracts for Itsa storage addresses, pages, I/O, lifecycle, and errors.",
  "version": "0.0.0",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty",
    "format": "prettier --config configs/.prettierrc.json --ignore-path configs/prettierignore --write .",
    "format:check": "prettier --config configs/.prettierrc.json --ignore-path configs/prettierignore --check .",
    "lint": "eslint . --config configs/eslint.config.js",
    "lint:fix": "eslint . --config configs/eslint.config.js --fix",
    "check:layout": "node .devenv/check-one-principal.mjs",
    "test": "vitest --config configs/vitest.config.ts",
    "clean:dist": "node .devenv/clean-dist.mjs",
    "build": "npm run clean:dist && npm run build:tsc",
    "build:tsc": "tsc --project tsconfig.json --pretty",
    "docs": "typedoc --options configs/typedoc.json",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "release:npm": "npm run build && node .devenv/publish-if-missing.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsaorg/storage-base.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/itsaorg/storage-base/issues"
  },
  "homepage": "https://github.com/itsaorg/storage-base#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": "26"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --config configs/.prettierrc.json --ignore-path configs/prettierignore --write",
    "*.ts": "eslint --config configs/eslint.config.js --fix"
  },
  "files": [
    "dist/",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts"
}
