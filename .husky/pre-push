#!/usr/bin/env sh
# =============================================================================
# 🚀 pre-push — npm run check (no vitest:coverage)
# =============================================================================
# ▶️ Skip once: HUSKY=0 git push …
# =============================================================================

HUSKY_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
. "$HUSKY_DIR/common.sh"

log_hook_banner "pre-push"

log_go "npm run check"
if npm run check; then
  log_ok "pre-push passed for ${PKG_NAME}@${PKG_VERSION}"
  exit 0
fi

log_err "pre-push failed (check)"
exit 1
